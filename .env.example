# Supabase の接続情報（Supabase ダッシュボード > Project Settings > API）
# これらは公開されるフロントに埋め込まれるが、anon key は RLS で保護されるため安全。
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# GitHub Pages の base パス（プロジェクトページの場合はリポジトリ名）
# 独自ドメイン or user/org ページなら "/" にする
VITE_BASE=/oyaji-club-web/
